# Copiar a .env localmente; nunca versionar valores reales.
NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portafolio_desarrollo
DB_USER=usuario_aplicacion
DB_PASSWORD=valor_ficticio_reemplazar
# Alternativa a DB_*: ejemplo TOTALMENTE FICTICIO, no apunta a Neon real.
# DATABASE_URL=postgresql://usuario_demo:valor_ficticio@db.example.invalid:5432/base_demo?sslmode=require&connect_timeout=10
# En Vercel: configurar DATABASE_URL como secreto, NODE_ENV=production,
# DB_SSL=true, CORS_ORIGINS con el origen HTTPS propio y STORAGE_DRIVER=disabled.
# La URL admite sslmode=require/verify-full y connect_timeout=1..60 (segundos).
# channel_binding=require NO se ignora: se rechaza porque esta integración
# Sequelize/pg no garantiza obligatoriedad. Si esa política es requisito,
# hace falta otra integración compatible; no quitarla sin evaluar ese requisito.
# Para URLs con sslmode seguro: quitar DB_SSL=false o cambiarlo a true.
DB_SSL=false
# DB_SSL_CA=certificado_PEM_del_proveedor
DB_POOL_MAX=2
# Generar y configurar manualmente una clave aleatoria de al menos 32 bytes.
JWT_SECRET=reemplazar_por_una_clave_aleatoria_no_usar_este_ejemplo
JWT_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# En producción: disabled hasta incorporar almacenamiento de objetos.
STORAGE_DRIVER=local
LOGIN_RATE_LIMIT=10
REGISTRATION_RATE_LIMIT=10
# Solo para una base nueva y vacía; no habilitar rutinariamente:
# MIGRATION_ALLOW_EMPTY_DATABASE=true
# SEED_ALLOW_EMPTY_DATABASE=true
# SEED_PASSWORD=valor_ficticio_solo_para_datos_de_demostracion
