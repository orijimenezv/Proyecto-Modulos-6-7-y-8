{
  "info": {
    "name": "API de usuarios y pedidos - Fase 1",
    "description": "Colección actual. Solo usar una BD de pruebas autorizada. Las escrituras y eliminaciones son reales. No ejecutar sobre la base del curso. Las colecciones YAML son históricas. Definir email/password en variables locales no compartidas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "demo@example.invalid"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "archivoNombre",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Estado y registro",
      "item": [
        {
          "name": "Estado del proceso",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear cuenta nueva (escribe datos)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/usuarios",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cuenta Demo\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Sesión",
      "item": [
        {
          "name": "Login y guardar token local",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('token', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sin token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/pedidos",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token inválido",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/pedidos",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "invalid-test-token",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Mi cuenta",
      "item": [
        {
          "name": "Mi cuenta y guardar ID local",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/usuarios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200 && pm.response.json().data.length) pm.environment.set('userId', pm.response.json().data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi cuenta SQL parametrizado",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/usuarios/sql?limit=20&offset=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtro nombre",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/usuarios?nombre=Demo"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi detalle",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/usuarios/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi cuenta con pedidos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/usuarios/{{userId}}/detalles"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar mi nombre",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/usuarios/{{userId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cuenta Demo Actualizada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Mis pedidos",
      "item": [
        {
          "name": "Crear pedido propio",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/pedidos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto\": \"Producto Demo\",\n  \"cantidad\": 1,\n  \"total\": \"12.50\",\n  \"estado\": \"pendiente\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('pedidoId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar propios",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/pedidos?limit=20&offset=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener propio",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar propio",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"cancelado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Validación cantidad inválida",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/pedidos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto\": \"Producto Demo\",\n  \"cantidad\": 0,\n  \"total\": \"12.50\",\n  \"estado\": \"pendiente\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Archivos locales privados",
      "item": [
        {
          "name": "Subir imagen - seleccionar archivo sintético",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "archivo",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('archivoNombre', pm.response.json().data.nombre);"
                ]
              }
            }
          ]
        },
        {
          "name": "Descargar archivo propio",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/archivos/{{archivoNombre}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 - Transacción opcional",
      "item": [
        {
          "name": "Registrar otra cuenta y primer pedido - cambiar email antes",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/usuarios/transaccion",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": {\n    \"nombre\": \"Cuenta Demo\",\n    \"email\": \"otra-demo@example.invalid\",\n    \"password\": \"{{password}}\"\n  },\n  \"pedido\": {\n    \"producto\": \"Producto Demo\",\n    \"cantidad\": 1,\n    \"total\": \"12.50\",\n    \"estado\": \"pendiente\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "forzarError ya no está permitido",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/usuarios/transaccion",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": {\n    \"nombre\": \"Cuenta Demo\",\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n  },\n  \"pedido\": {\n    \"producto\": \"Producto Demo\",\n    \"cantidad\": 1,\n    \"total\": \"12.50\",\n    \"estado\": \"pendiente\"\n  },\n  \"forzarError\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "99 - Eliminación manual (revisar IDs antes)",
      "item": [
        {
          "name": "Eliminar mi pedido",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar mi cuenta y pedidos - invalida sesión",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/usuarios/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
